{
  "name": "Periastron-Tower-Defense-MapEditor",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,

      "Packages": {
        "$path": "Packages"
      },

      "ReplicaShared": {
        "$path": "../vendor/ReplicaShared"
      },

      "vfx": {
        "$path": "../vendor/vfx"
      },

      "MapEditor": {
        "$path": "../common/mapeditor"
      },

      "Shared": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,

        "Vendor": { "$path": "../vendor/shared" },
        "Config": { "$path": "../common/shared/Config" },
        "Util": { "$path": "../common/shared/Util" },
        "Classes": { "$path": "../common/shared/Classes" }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,

      "Server": { "$path": "../common/server/Server" },
      "Config": { "$path": "../common/server/Config" },
      "Vendor": { "$path": "../vendor/server" },

      "CmdrDefinitions": {
        "$className": "Folder",
        "$ignoreUnknownInstances": false,

        "Types": {
          "$className": "Folder",
          "$ignoreUnknownInstances": false,

          "Common": { "$path": "../common/server/CmdrDefinitions/Types" }
        },

        "Commands": {
          "$className": "Folder",
          "$ignoreUnknownInstances": false,

          "Common": { "$path": "../common/server/CmdrDefinitions/Commands" }
        }
      },

      "Services": {
        "$className": "Folder",
        "$ignoreUnknownInstances": false,
        "$attributes": { "Place": "MapEditor" },

        "Common": { "$path": "../common/server/Services" }
      },

      "MapEditor": {
        "$path": "src/Server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,

        "Client": {
          "$className": "Folder",

          "Controllers": { "$className": "Folder" }
        },

        "MapEditor": {
          "$path": "src/ClientBoot",

          "GameVFX": {
            "$className": "Folder",

            "VFXController": { "$path": "../Game/src/Controllers/VFXController.luau" },
            "ProjectileController": { "$path": "../Game/src/Controllers/ProjectileController.luau" },
            "TripmineController": { "$path": "../Game/src/Controllers/TripmineController.luau" },
            "BonfireController": { "$path": "../Game/src/Controllers/BonfireController.luau" }
          }
        }
      }
    }
  }
}
